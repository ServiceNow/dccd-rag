# Copy to .env and fill in your keys. scripts/evaluate.py reads .env from the
# working directory and drqa/build_drqa.py from the repository; .env is gitignored.

# REQUIRED for: DRQA LLM-as-judge evaluation (scripts/evaluate.py --metric judge)
# and (re)building DRQA (drqa/build_drqa.py). Default judge/builder model is
# anthropic/claude-opus-4-5, routed through OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# OPTIONAL: only if you point the DRQA builder at a bare OpenAI model id
# (e.g. --model gpt-4o-mini) instead of an OpenRouter "provider/model" id.
# OPENAI_API_KEY=sk-...

# OPTIONAL: Hugging Face token for faster / gated model + dataset downloads
# (Qwen3.5, Phi-3, Atipico1/popQA_preprocessed, aialt/RetrievalQA). Not required
# for the public models/datasets used here.
# HF_TOKEN=hf_...

# OPTIONAL: where model weights + downloaded datasets are cached. The code sets
# no cache dir, so caching uses the standard Hugging Face location
# (~/.cache/huggingface) OUTSIDE this repo. Set HF_HOME to relocate it
# (e.g. to a large scratch disk).
# HF_HOME=/path/to/hf_cache
